# Application
APP_NAME=secure-docs-api
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=postgresql+asyncpg://securedocs:securedocs_dev@localhost:5432/securedocs
DATABASE_ECHO=false

# Auth / JWT
SECRET_KEY=CHANGE-ME-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Passwords
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# S3 (optional)
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# File uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv

# Rate limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_UPLOAD=10/minute
